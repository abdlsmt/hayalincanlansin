---
import Icon from './Icon.astro';

const points = [
  {
    icon: 'check-circle',
    strong: 'Bağımsız bir girişim.',
    text: 'Hayalin Canlansın, bireysel olarak geliştirilen, erken aşamadaki bir yaratıcı teknoloji projesidir.',
  },
  {
    icon: 'moon',
    strong: 'Vizyon.',
    text: 'Kişisel anıların ve hayallerin, nesiller boyunca saklanacak anlamlı hikâyelere dönüştüğü bir deneyim inşa etmek.',
  },
  {
    icon: 'rocket',
    strong: 'Uzun vadeli hedef.',
    text: 'Zamanla kişiselleştirilmiş hikâyeler, dijital hediyeler ve yaratıcı deneyimleri bir arada sunan bir platforma dönüşmek.',
  },
];
---

<section class="section" id="hakkimizda" aria-labelledby="hakkimizda-baslik">
  <div class="container">
    <div class="about-grid">
      <div class="about-visual" data-reveal="left">
        <svg
          viewBox="0 0 480 400"
          role="img"
          aria-labelledby="aboutGorselBaslik aboutGorselAciklama"
        >
          <title id="aboutGorselBaslik">Büyüyen bir hikâye</title>
          <desc id="aboutGorselAciklama">
            Küçük bir fidandan yükselen gövde, tepesinde bir yıldızla
            son bulan; büyüyen bir hikâyeyi simgeleyen sahne.
          </desc>
          <defs>
            <linearGradient id="aboutCerceve" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#EDE8F8" />
              <stop offset="1" stop-color="#F6D7E0" />
            </linearGradient>
          </defs>
          <rect width="480" height="400" rx="36" fill="url(#aboutCerceve)" />

          <!-- Arka plan yıldızları -->
          <g fill="#FFFFFF">
            <path class="twinkle" transform="translate(90 90) scale(0.6)"
              d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
            <path class="twinkle twinkle--2" transform="translate(400 70) scale(0.5)"
              d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
            <circle class="twinkle twinkle--3" cx="420" cy="160" r="3.4" />
            <circle class="twinkle" cx="70" cy="220" r="3" />
          </g>

          <!-- Fidan → yıldız -->
          <g>
            <path
              d="M240 330c-2-40-2-80 0-110"
              fill="none"
              stroke="#5B4E8C"
              stroke-width="7"
              stroke-linecap="round"
            />
            <!-- Yapraklar -->
            <path d="M240 290c-26-6-40-24-38-44 24 4 40 22 38 44Z" fill="#7C6BB8" />
            <path d="M240 262c26-6 40-24 38-44-24 4-40 22-38 44Z" fill="#C9BFF2" />
            <path d="M240 232c-20-5-32-20-30-36 20 4 32 18 30 36Z" fill="#A89AD4" />
            <!-- Tepedeki yıldız -->
            <path
              class="float-slow"
              transform="translate(240 130) scale(2.2)"
              fill="#F9C9A8"
              d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z"
            />
            <!-- Fidan kabı -->
            <path d="M196 330h88l-12 44H208Z" fill="#E8AEC4" />
            <rect x="188" y="322" width="104" height="14" rx="7" fill="#E8A06C" />
          </g>

          <!-- Yükselen parçacıklar -->
          <g fill="#FFFFFF">
            <circle class="float-med" cx="196" cy="180" r="4" />
            <circle class="float-slow" cx="288" cy="160" r="3.4" />
            <circle class="float-med" cx="214" cy="110" r="3" />
          </g>
        </svg>
      </div>

      <div data-reveal="right">
        <div class="section-head" style="margin-bottom: 1.5rem">
          <p class="eyebrow">Hakkımızda</p>
          <h2 class="section-title" id="hakkimizda-baslik">
            Küçük bir hikâye, büyük bir hayal
          </h2>
          <p class="section-lead">
            Hayalin Canlansın, kişisel anıları anlamlı hikâyelere
            dönüştürmek için bağımsız olarak geliştirilen, erken
            aşamadaki bir yaratıcı teknoloji girişimidir. Şu anda
            ürün geliştirme öncesi hazırlık aşamasındayız.
          </p>
        </div>
        <div class="about-points">
          {points.map((point) => (
            <div class="about-point">
              <span class="point-icon">
                <Icon name={point.icon} />
              </span>
              <p>
                <strong>{point.strong}</strong> {point.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
