---
const navLinks = [
  { href: '#demo', label: 'Demo' },
  { href: '#urunler', label: 'Ürünler' },
  { href: '#nasil', label: 'Nasıl Çalışır?' },
  { href: '#ornekler', label: 'Örnekler' },
  { href: '#yol-haritasi', label: 'Yol Haritası' },
  { href: '#hakkimizda', label: 'Hakkımızda' },
  { href: '#iletisim', label: 'İletişim' },
];
---

<header class="site-header" id="siteHeader">
  <nav class="nav container" aria-label="Ana menü">
    <a class="brand" href="#anasayfa" aria-label="Hayalin Canlansın — Ana Sayfa">
      <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="14" fill="#7C6BB8" />
        <path
          d="M32 9l5.1 10.4 11.4 1.6-8.3 8 2 11.3L32 35.2l-10.2 5.1 2-11.3-8.3-8 11.4-1.6z"
          fill="#FAF6EF"></path>
        <path
          d="M16 45.5c3.2-2.6 6.4-4 9.8-4.8 2.6-3.7 5.8-3.7 8.4 0 2.6 3.8 5.8 3.8 8.4 0 3.4.8 6.6 2.2 9.8 4.8v7.7H16z"
          fill="#F9C9A8"></path>
      </svg>
      <span class="brand-word">Hayalin <em>Canlansın</em></span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="navMenu"
      aria-label="Menüyü aç"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-menu" id="navMenu">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} data-nav-link>{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
