---
---

<section class="hero" id="anasayfa" aria-labelledby="hero-baslik">
  <div class="container hero-grid">
    <div>
      <p class="hero-badge" data-reveal>
        <span class="dot" aria-hidden="true"></span>
        Şu anda geliştirme aşamasında
      </p>

      <h1 class="hero-title" id="hero-baslik" data-reveal>
        Hayallerin Bir <span class="accent">Hikâyeye</span> Dönüşsün.
      </h1>

      <p class="hero-lead" data-reveal>
        Sevdiklerin için unutulmaz hikâyeler, kişiye özel masallar ve hayal
        gücünü gerçeğe yaklaştıran yaratıcı deneyimler hazırlıyoruz.
      </p>

      <div class="hero-actions" data-reveal>
        <a class="btn btn--primary" href="#urunler">
          Neler Hazırlıyoruz?
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn btn--ghost" href="#ornekler">Örnekleri Keşfet</a>
      </div>

      <p class="hero-note" data-reveal>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        Ürünlerimiz henüz satışa sunulmamaktadır. Site, projemizin tanıtımı
        ve yol haritasını paylaşmak için hazırlanmıştır.
      </p>
    </div>

    <div class="hero-scene" data-reveal="right">
      <svg
        viewBox="0 0 600 560"
        role="img"
        aria-labelledby="heroSahneBaslik heroSahneAciklama"
      >
        <title id="heroSahneBaslik">Masalsı sahne</title>
        <desc id="heroSahneAciklama">
          Yıldızlı bir gökyüzünde hilal ay ve bulutların arasında, ışık
          parçacıkları saçan açık bir kitap.
        </desc>
        <defs>
          <linearGradient id="heroGok" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#EDE8F8" />
            <stop offset="0.62" stop-color="#F6D7E0" />
            <stop offset="1" stop-color="#F9C9A8" />
          </linearGradient>
          <linearGradient id="heroSayfa" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#FFFFFF" />
            <stop offset="1" stop-color="#F2EBDF" />
          </linearGradient>
          <linearGradient id="heroKapak" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7C6BB8" />
            <stop offset="1" stop-color="#5B4E8C" />
          </linearGradient>
        </defs>

        <!-- Gökyüzü -->
        <circle cx="300" cy="280" r="252" fill="url(#heroGok)" />

        <!-- Hilal ay -->
        <path
          class="float-slow"
          d="M168 118a58 58 0 1 0 47 100 47 47 0 1 1-47-100Z"
          fill="#FFFFFF"
          opacity="0.95"
        />

        <!-- Yıldızlar -->
        <g fill="#FFFFFF">
          <path class="twinkle" transform="translate(232 118) scale(0.9)"
            d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
          <path class="twinkle twinkle--2" transform="translate(398 96) scale(0.7)"
            d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
          <path class="twinkle twinkle--3" transform="translate(452 190) scale(0.55)"
            d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
          <path class="twinkle twinkle--2" transform="translate(140 220) scale(0.5)"
            d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />
          <circle class="twinkle twinkle--3" cx="330" cy="70" r="4" />
          <circle class="twinkle" cx="500" cy="270" r="3.2" />
          <circle class="twinkle twinkle--2" cx="108" cy="300" r="3.4" />
        </g>

        <!-- Bulutlar -->
        <g fill="#FFFFFF" opacity="0.75">
          <ellipse class="float-med" cx="205" cy="200" rx="46" ry="16" />
          <ellipse class="float-med" cx="238" cy="188" rx="34" ry="14" />
          <ellipse class="float-slow" cx="430" cy="250" rx="42" ry="14" />
          <ellipse class="float-slow" cx="462" cy="240" rx="28" ry="12" />
        </g>

        <!-- Tepecikler -->
        <ellipse cx="180" cy="520" rx="220" ry="70" fill="#C9BFF2" opacity="0.4" />
        <ellipse cx="430" cy="535" rx="230" ry="75" fill="#F6D7E0" opacity="0.55" />

        <!-- Yükselen ışık parçacıkları -->
        <g fill="#FFFFFF">
          <circle class="float-med" cx="272" cy="330" r="4" />
          <circle class="float-slow" cx="300" cy="300" r="5" />
          <circle class="float-med" cx="330" cy="335" r="3.4" />
          <circle class="float-slow" cx="288" cy="255" r="3" />
          <circle class="float-med" cx="316" cy="235" r="3.6" />
        </g>
        <path class="twinkle" transform="translate(300 205) scale(0.8)" fill="#FFFFFF"
          d="M0 -11C1.6 -3.4 3.4 -1.6 11 0 3.4 1.6 1.6 3.4 0 11-1.6 3.4-3.4 1.6-11 0-3.4-1.6-1.6-3.4 0-11Z" />

        <!-- Açık kitap -->
        <g>
          <path
            d="M300 428c-32-16-68-19-98-11v64c30-8 66-5 98 11 32-16 68-19 98-11v-64c-30-8-66-5-98 11Z"
            fill="url(#heroKapak)"
          />
          <path
            d="M300 416c-28-14-60-17-86-10v56c26-7 58-4 86 10 28-14 60-17 86-10v-56c-26-7-58-4-86 10Z"
            fill="url(#heroSayfa)"
          />
          <!-- Sayfa çizgileri -->
          <g stroke="#C9BFF2" stroke-width="3" stroke-linecap="round" opacity="0.8">
            <path d="M232 424c14-3 30-2 44 3" />
            <path d="M232 440c14-3 30-2 44 3" />
            <path d="M232 456c14-3 30-2 44 3" />
            <path d="M324 427c14-5 30-6 44-3" />
            <path d="M324 443c14-5 30-6 44-3" />
            <path d="M324 459c14-5 30-6 44-3" />
          </g>
          <!-- Sayfalar arası çizgi -->
          <path d="M300 416v62" stroke="#E8AEC4" stroke-width="3" stroke-linecap="round" />
        </g>
      </svg>
    </div>
  </div>
</section>
