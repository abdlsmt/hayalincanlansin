---
import CategoryCard from './CategoryCard.astro';
import Icon from './Icon.astro';

const categories = [
  {
    icon: 'book-open',
    title: 'Bana Özel Masal',
    description:
      'Adın, karakterin ve hayal gücünle yazılan; yalnızca sana ait bir masal.',
    focus: true,
    status: 'Çalışan prototip var',
  },
  {
    icon: 'book',
    title: 'Kişiselleştirilmiş Hikâye Kitabı',
    description:
      'Kahramanın adını taşıyan, sayfa sayfa okunan bir hikâye kitabı deneyimi.',
    focus: true,
    status: 'Prototip aşamasında',
  },
  {
    icon: 'compass',
    title: 'Hayalimdeki Macera',
    description:
      'Senin hayal ettiğin dünyaya, senin kurallarınla yapılan kişisel bir macera.',
    focus: false,
    status: 'Konsept aşamasında',
  },
  {
    icon: 'heart',
    title: 'Anılarımızdan Bir Hikâye',
    description:
      'Aile anıların ve özel günlerinin, güçlendirici bir hikâyeye dönüştürülmüş bir anlatıya dönüşmesi.',
    focus: false,
    status: 'Konsept aşamasında',
  },
  {
    icon: 'gift',
    title: 'Özel Gün Sürprizleri',
    description:
      'Doğum günleri, yıldönümleri ve özel günler için hazırlanacak dijital sürprizler.',
    focus: false,
    status: 'Gelecek genişleme',
  },
  {
    icon: 'sparkles',
    title: 'Dijital Hikâye Deneyimleri',
    description:
      'Okurken yaşanan, etkileşimli dijital hikâye ve görsel anlatı deneyimleri.',
    focus: false,
    status: 'Gelecek genişleme',
  },
];
---

<section class="section" id="urunler" aria-labelledby="urunler-baslik">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Neler Yapıyoruz?</p>
      <h2 class="section-title" id="urunler-baslik">
        Odak: kişiselleştirilmiş çocuk hikâyeleri
      </h2>
      <p class="section-lead">
        Ana ürünümüz, ismi ve hayalleri kahramana dönüşen çocuk
        hikâyeleri ile resimli hikâye kitapları. Diğer başlıklar
        gelecekteki genişleme alanlarımızdır.
      </p>
    </div>

    <div class="category-grid">
      {categories.map((item) => (
        <CategoryCard
          title={item.title}
          description={item.description}
          focus={item.focus}
          status={item.status}
        >
          <Icon name={item.icon} slot="icon" />
        </CategoryCard>
      ))}
    </div>
  </div>
</section>
