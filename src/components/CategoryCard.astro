---
interface Props {
  title: string;
  description: string;
  focus?: boolean;
  status: string;
}

const { title, description, focus = false, status } = Astro.props;
---

<article class:list={['card', focus && 'card--focus']} data-reveal>
  <div class="card-icon">
    <slot name="icon" />
  </div>
  <div class="card-headings">
    <h3>{title}</h3>
    {focus && <span class="chip">Ana ürün</span>}
  </div>
  <p>{description}</p>
  <span class="badge badge--soon">{status}</span>
</article>
