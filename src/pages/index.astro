---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import StoryDemo from '../components/StoryDemo.astro';
import ProductCategories from '../components/ProductCategories.astro';
import HowItWorks from '../components/HowItWorks.astro';
import StoryCard from '../components/StoryCard.astro';
import SampleStory from '../components/SampleStory.astro';
import TechCreativity from '../components/TechCreativity.astro';
import Roadmap from '../components/Roadmap.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';

const stories: {
  variant: 'space' | 'forest' | 'ocean';
  title: string;
  description: string;
}[] = [
  {
    variant: 'space',
    title: 'Uzay Macerası',
    description:
      'Sönen bir yıldızın ışığını geri getirmek için yıldızların arasına yapılan, cesaret ve dostluk üzerine bir yolculuk.',
  },
  {
    variant: 'forest',
    title: 'Büyülü Orman Masalı',
    description:
      'Sararan yaprakların ve fısıldayan ağaçların arasında, ormanın kalbine ulaşmayı amaçlayan bir masal.',
  },
  {
    variant: 'ocean',
    title: 'Deniz Altı Dünyası',
    description:
      'Sönen bir deniz fenerinin ışığını derinlerde arayan, yunuslarla ve incilerle geçen bir su altı macerası.',
  },
];
---

<MainLayout
  title="Ana Sayfa"
  description="Hayalin Canlansın — kişisel anıları ve hayallerin, kişiye özel masallar, hikâye kitapları ve yaratıcı dijital deneyimlere dönüştüğü bir yaratıcı teknoloji girişimi. Geliştirme aşamasında."
>
  <Hero />
  <StoryDemo />
  <ProductCategories />
  <HowItWorks />

  <section class="section" id="ornekler" aria-labelledby="ornekler-baslik">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">Örnekler</p>
        <h2 class="section-title" id="ornekler-baslik">
          Konsept örneklerimiz
        </h2>
        <p class="section-lead">
          Aşağıdaki üç hikâye, yukarıdaki demodaki üç temanın konsept
          örnekleridir. Üretim kalitesinde bir kitap değil, ürün
          yönünü anlatan örnektir.
        </p>
      </div>

      <div class="story-grid">
        {stories.map((story) => (
          <StoryCard
            variant={story.variant}
            title={story.title}
            description={story.description}
          />
        ))}
      </div>

      <SampleStory />
    </div>
  </section>

  <TechCreativity />
  <Roadmap />
  <About />
  <Contact />
</MainLayout>
